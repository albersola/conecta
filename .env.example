# HTTP API
HOSTNAME=0.0.0.0
PORT=3000

# Required: use a long random value. This key protects every deployment webhook.
CONECTA_API_KEY=replace-with-a-long-random-api-key

# Docker and persistence
CONECTA_DOCKER_NETWORK=conecta
CONECTA_DB_PATH=/data/conecta.sqlite

# Internal authoritative DNS
CONECTA_DNS_HOSTNAME=0.0.0.0
CONECTA_DNS_PORT=5353
CONECTA_DNS_ZONE=svc.internal
CONECTA_DNS_TTL_SECONDS=5
CONECTA_DNS_PROPAGATION_SECONDS=10
