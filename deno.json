{
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "dns2": "npm:dns2@3.1.1"
  },
  "tasks": {
    "dev": "deno run --env-file=.env --allow-net --allow-env --allow-read=/app,/data,/tmp --allow-write=/data,/tmp --allow-run=docker --watch src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read=/app,/data,/tmp --allow-write=/data,/tmp --allow-run=docker src/main.ts",
    "check": "deno check src/*.ts",
    "test": "deno test --allow-env --allow-net --allow-read=.,/tmp --allow-write=/tmp src/*_test.ts",
    "fmt": "deno fmt src"
  }
}
